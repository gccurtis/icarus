+  if (gap < 2 * DAY) return "yesterday";
+  if (gap < 30 * DAY) return `${Math.round(gap / DAY)} days ago`;
+  return new Date(at).toLocaleDateString(undefined, {
+    month: "short",
+    day: "numeric",
+    year: "numeric"
+  });
 };
 
