{
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["ESNext", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "allowJs": true,
    "noEmit": true,
    "forceConsistentCasingInFileNames": true,
    "paths": {
      "$convex/*": ["./*"],
      "$access/*": ["../lib/capabilities/access/*"],
      "$activity/*": ["../lib/capabilities/activity/*"],
      "$comments/*": ["../lib/capabilities/comments/*"],
      "$content/*": ["../lib/capabilities/content/*"],
      "$derived-outputs/*": ["../lib/capabilities/derived-outputs/*"],
      "$documents/*": ["../lib/capabilities/documents/*"],
      "$external-files/*": ["../lib/capabilities/external-files/*"],
      "$findings/*": ["../lib/capabilities/findings/*"],
      "$formula/*": ["../lib/capabilities/formula/*"],
      "$hypotheses/*": ["../lib/capabilities/hypotheses/*"],
      "$knowledge/*": ["../lib/capabilities/knowledge/*"],
      "$messages/*": ["../lib/capabilities/messages/*"],
      "$name-manager/*": ["../lib/capabilities/name-manager/*"],
      "$persona-threads/*": ["../lib/capabilities/persona-threads/*"],
      "$personas/*": ["../lib/capabilities/personas/*"],
      "$questions/*": ["../lib/capabilities/questions/*"],
      "$research-links/*": ["../lib/capabilities/research-links/*"],
      "$research-threads/*": ["../lib/capabilities/research-threads/*"],
      "$resource-sets/*": ["../lib/capabilities/resource-sets/*"],
      "$revisions/*": ["../lib/capabilities/revisions/*"],
      "$settings/*": ["../lib/capabilities/settings/*"],
      "$slide-decks/*": ["../lib/capabilities/slide-decks/*"],
      "$spreadsheets/*": ["../lib/capabilities/spreadsheets/*"],
      "$templates/*": ["../lib/capabilities/templates/*"],
      "$shared/*": ["../lib/capabilities/shared/*"],
      "$model/*": ["../lib/model/*"]
    }
  },
  "include": ["./**/*"],
  "exclude": ["./_generated"]
}
