{
  "name": "@icarus/frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "pnpm typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "svelte-kit sync && vitest run",
    "test:scripts": "node --test --test-concurrency=1 \"scripts/test/*.test.mjs\" \"scripts/generation/*/test/*.test.mjs\"",
    "lint": "node scripts/lint.mjs",
    "lint:capabilities": "node scripts/lint.mjs capabilities",
    "lint:components": "node scripts/lint.mjs components",
    "lint:model": "node scripts/lint.mjs model",
    "lint:representation": "node scripts/lint.mjs representation",
    "lint:runtime": "node scripts/lint.mjs runtime",
    "lint:styles": "node scripts/lint.mjs styles",
    "lint:views": "node scripts/lint.mjs views panels workspaces",
    "lint:across": "node scripts/lint.mjs across",
    "new-capability": "node scripts/generation/capabilities/new-capability.mjs",
    "new-procedure": "node scripts/generation/capabilities/new-procedure.mjs",
    "new-constant": "node scripts/generation/capabilities/new-constant.mjs",
    "new-vocabulary": "node scripts/generation/components/new-vocabulary.mjs",
    "new-component": "node scripts/generation/components/new-component.mjs",
    "new-model-object": "node scripts/generation/model/new-model-object.mjs",
    "new-method": "node scripts/generation/model/new-method.mjs",
    "new-domain": "node scripts/generation/representation/new-domain.mjs",
    "new-table": "node scripts/generation/representation/new-table.mjs",
    "new-theme": "node scripts/generation/styles/new-theme.mjs",
    "new-token": "node scripts/generation/styles/new-token.mjs",
    "new-surface": "node scripts/generation/views/new-surface.mjs",
    "new-concern-entry": "node scripts/generation/views/new-concern-entry.mjs",
    "new-panel": "node scripts/generation/panels/new-panel.mjs",
    "new-workspace": "node scripts/generation/workspaces/new-workspace.mjs",
    "screen-keys": "node scripts/generation/representation/screens.mjs",
    "aliases": "node scripts/generation/across/aliases.mjs",
    "imports": "node scripts/generation/across/imports.mjs",
    "clean": "rm -rf build .svelte-kit"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "latest",
    "@fontsource/ibm-plex-sans": "latest",
    "bits-ui": "^2.19.0",
    "clsx": "latest",
    "layerchart": "^2.2.0",
    "pino": "latest",
    "tailwind-merge": "latest",
    "tailwind-variants": "^3.3.1",
    "yaml": "latest"
  },
  "devDependencies": {
    "@internationalized/date": "^3.12.3",
    "@lucide/svelte": "latest",
    "@sveltejs/adapter-node": "latest",
    "@sveltejs/kit": "latest",
    "@sveltejs/vite-plugin-svelte": "latest",
    "@tailwindcss/vite": "latest",
    "@types/node": "latest",
    "embla-carousel-svelte": "latest",
    "paneforge": "latest",
    "postcss": "^8.5.26",
    "postcss-value-parser": "^4.2.0",
    "svelte": "latest",
    "svelte-check": "latest",
    "tailwindcss": "latest",
    "tw-animate-css": "latest",
    "typescript": "~6",
    "vite": "latest",
    "vitest": "latest"
  }
}
