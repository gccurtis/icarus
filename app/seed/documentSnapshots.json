              "atoms": [
                {
                  "id": "#abody1",
                  "kind": "literal",
                  "text": "Substation 14 is the binding constraint. Its transformer bank was derated in September after the oil analysis came back, and the two feeders that would otherwise pick up its load both run through the same corridor, so a fault on either leaves the northern ring supplied from one direction only. The corridor itself is scheduled for reconductoring but not until the following summer, which puts the whole of this winter inside the window."
                }
              ],
              "display": "Substation 14 is the binding constraint. Its transformer bank was derated in September after the oil analysis came back, and the two feeders that would otherwise pick up its load both run through the same corridor, so a fault on either leaves the northern ring supplied from one direction only. The corridor itself is scheduled for reconductoring but not until the following summer, which puts the whole of this winter inside the window.",
              "marks": []
            }
          ]
        },
