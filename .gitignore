node_modules/
dist/
build/
.svelte-kit/
.pnpm-store/
.env
.env.*
!.env.example
.vite/
coverage/
.DS_Store
*.tsbuildinfo
logs/*.log

# Runtime artifacts — state a run produces, never state a checkout needs.
app/logs/*.log

# Agent worktrees
.claude/worktrees/

# Agent scratch: subagent-driven-development ledgers, briefs, and review packages
.superpowers/

# Nothing is pinned: lockfiles are regenerable local caches, not committed state.
flake.lock
pnpm-lock.yaml

# Convex writes this from the schema and functions it pushed. Same reasoning as
# the lockfiles: regenerable output, not state a checkout needs. `pnpm dev:convex`
# produces it, and must run once before `pnpm typecheck` will pass.
app/src/convex/_generated/

# Local configuration overrides — real secrets live here
*.local.yaml
**/configuration/local.yaml

# Generated by docs/screen-deck/src/mkfonts.mjs and build.mjs
docs/screen-deck/src/fonts.html
docs/screen-deck/src/_preview.html
docs/screen-deck/icarus-screen-deck.html
