{
  "name": "@icarus/frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "pnpm typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "svelte-kit sync && vitest run",
    "lint:capabilities": "node scripts/lint/capabilities/lint.mjs",
    "new-capability": "node scripts/generation/capabilities/new-capability.mjs",
    "new-api": "node scripts/generation/capabilities/new-api.mjs",
    "test:scripts": "node --test \"scripts/*/*/test/*.test.mjs\"",
    "clean": "rm -rf build .svelte-kit"
  },
  "dependencies": {
    "@electric-sql/pglite": "latest",
    "@fontsource/ibm-plex-mono": "latest",
    "@fontsource/ibm-plex-sans": "latest",
    "bits-ui": "latest",
    "clsx": "latest",
    "kysely": "latest",
    "pino": "latest",
    "tailwind-merge": "latest",
    "tailwind-variants": "latest",
    "yaml": "latest"
  },
  "devDependencies": {
    "@internationalized/date": "latest",
    "@lucide/svelte": "latest",
    "@sveltejs/adapter-node": "latest",
    "@sveltejs/kit": "latest",
    "@sveltejs/vite-plugin-svelte": "latest",
    "@tailwindcss/vite": "latest",
    "@types/node": "latest",
    "embla-carousel-svelte": "latest",
    "paneforge": "latest",
    "svelte": "latest",
    "svelte-check": "latest",
    "tailwindcss": "latest",
    "tw-animate-css": "latest",
    "typescript": "~6",
    "vite": "latest",
    "vitest": "latest"
  }
}
