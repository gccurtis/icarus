{
  "compilerOptions": {
    "target": "ESNext",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "rootDir": "src",
    "outDir": "dist",
    "lib": [
      "ESNext"
    ],
    "types": [
      "node"
    ],
    "paths": {
      "#config-files/*": [
        "./configuration/*"
      ],
      "#configuration/*": [
        "./src/capabilities/platform/configuration/*"
      ],
      "#package.json": [
        "./package.json"
      ],
      "#registry/*": [
        "./src/registry/*"
      ],
      "#capabilities/*": [
        "./src/capabilities/*"
      ],
      "#workflows/*": [
        "./src/workflows/*"
      ],
      "#shared/*": [
        "./src/shared/*"
      ],
      "#automations": [
        "./src/capabilities/agentic/automations/index.ts"
      ],
      "#automations/*": [
        "./src/capabilities/agentic/automations/*"
      ],
      "#built-in": [
        "./src/capabilities/built-in/index.ts"
      ],
      "#built-in/*": [
        "./src/capabilities/built-in/*"
      ],
      "#comments": [
        "./src/capabilities/collaboration/comments/index.ts"
      ],
      "#comments/*": [
        "./src/capabilities/collaboration/comments/*"
      ],
      "#configuration": [
        "./src/capabilities/platform/configuration/index.ts"
      ],
      "#connector": [
        "./src/capabilities/resource-special/connector/index.ts"
      ],
      "#connector/*": [
        "./src/capabilities/resource-special/connector/*"
      ],
      "#context": [
        "./src/capabilities/resource-special/context/index.ts"
      ],
      "#context/*": [
        "./src/capabilities/resource-special/context/*"
      ],
      "#data-manager": [
        "./src/capabilities/data/manager/index.ts"
      ],
      "#data-manager/*": [
        "./src/capabilities/data/manager/*"
      ],
      "#document": [
        "./src/capabilities/resource-general/document/index.ts"
      ],
      "#document/*": [
        "./src/capabilities/resource-general/document/*"
      ],
      "#formula": [
        "./src/capabilities/data/formula/index.ts"
      ],
      "#formula/*": [
        "./src/capabilities/data/formula/*"
      ],
      "#general-files": [
        "./src/capabilities/resource-special/general-files/index.ts"
      ],
      "#general-files/*": [
        "./src/capabilities/resource-special/general-files/*"
      ],
      "#hypothesis": [
        "./src/capabilities/investigation/hypothesis/index.ts"
      ],
      "#hypothesis/*": [
        "./src/capabilities/investigation/hypothesis/*"
      ],
      "#intelligence": [
        "./src/capabilities/platform/intelligence/index.ts"
      ],
      "#intelligence/*": [
        "./src/capabilities/platform/intelligence/*"
      ],
      "#lattice": [
        "./src/capabilities/knowledge/lattice/index.ts"
      ],
      "#lattice/*": [
        "./src/capabilities/knowledge/lattice/*"
      ],
      "#observability": [
        "./src/capabilities/platform/observability/index.ts"
      ],
      "#observability/*": [
        "./src/capabilities/platform/observability/*"
      ],
      "#output": [
        "./src/capabilities/knowledge/output/index.ts"
      ],
      "#output/*": [
        "./src/capabilities/knowledge/output/*"
      ],
      "#persistence": [
        "./src/capabilities/platform/persistence/index.ts"
      ],
      "#persistence/*": [
        "./src/capabilities/platform/persistence/*"
      ],
      "#persona": [
        "./src/capabilities/agentic/persona/index.ts"
      ],
      "#persona/*": [
        "./src/capabilities/agentic/persona/*"
      ],
      "#project": [
        "./src/capabilities/collaboration/project/index.ts"
      ],
      "#project/*": [
        "./src/capabilities/collaboration/project/*"
      ],
      "#question": [
        "./src/capabilities/investigation/question/index.ts"
      ],
      "#question/*": [
        "./src/capabilities/investigation/question/*"
      ],
      "#research": [
        "./src/capabilities/investigation/research/index.ts"
      ],
      "#research/*": [
        "./src/capabilities/investigation/research/*"
      ],
      "#rich-content": [
        "./src/capabilities/resource-support/rich-content/index.ts"
      ],
      "#rich-content/*": [
        "./src/capabilities/resource-support/rich-content/*"
      ],
      "#slide": [
        "./src/capabilities/resource-general/slide/index.ts"
      ],
      "#slide/*": [
        "./src/capabilities/resource-general/slide/*"
      ],
      "#spreadsheet": [
        "./src/capabilities/resource-general/spreadsheet/index.ts"
      ],
      "#spreadsheet/*": [
        "./src/capabilities/resource-general/spreadsheet/*"
      ],
      "#task": [
        "./src/capabilities/agentic/task/index.ts"
      ],
      "#task/*": [
        "./src/capabilities/agentic/task/*"
      ],
      "#templates": [
        "./src/capabilities/resource-support/templates/index.ts"
      ],
      "#templates/*": [
        "./src/capabilities/resource-support/templates/*"
      ],
      "#web-server": [
        "./src/capabilities/platform/web-server/index.ts"
      ],
      "#web-server/*": [
        "./src/capabilities/platform/web-server/*"
      ]
    },
    "verbatimModuleSyntax": true
  },
  "include": [
    "src/**/*.ts"
  ],
  "exclude": [
    "reference"
  ]
}
