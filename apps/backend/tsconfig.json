{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "lib": ["ES2022"],
    "types": ["node"],
    "paths": {
      "#utils/*": ["./src/0-utils/*"],
      "#init/*": ["./src/1-init/*"],
      "#transport/*": ["./src/2-transport/*"],
      "#capabilities/*": ["./src/3-capabilities/*"],
      "#job-wiring/*": ["./src/4-job-wiring/*"],
      "#platform/*": ["./src/0-platform/*"],
      "#formula": ["./src/0-platform/formula/index.ts"],
      "#formula/*": ["./src/0-platform/formula/*"],
      "#name-manager": ["./src/3-capabilities/name-manager/index.ts"],
      "#name-manager/*": ["./src/3-capabilities/name-manager/*"],
      "#structured-data": ["./src/3-capabilities/structured-data/index.ts"],
      "#structured-data/*": ["./src/3-capabilities/structured-data/*"],
      "#context": ["./src/3-capabilities/context/index.ts"],
      "#context/*": ["./src/3-capabilities/context/*"]
    }
  },
  "include": ["src/**/*.ts"]
}
