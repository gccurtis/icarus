  "scripts": {
    "dev": "tsx watch --conditions=development src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "clean": "rm -rf dist",
    "lint": "node scripts/lint-paths.mjs"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.4",
    "fastify": "latest",
    "kysely": "^0.29.5",
    "pg-boss": "^12.27.0",
    "pino": "^10.3.1",
    "yaml": "latest"
