{
  "name": "@icarus/backend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "imports": {
    "#utils/*": {
      "types": "./src/0-utils/*",
      "default": "./dist/0-utils/*"
    },
    "#init/*": {
      "types": "./src/1-init/*",
      "default": "./dist/1-init/*"
    },
    "#transport/*": {
      "types": "./src/2-transport/*",
      "default": "./dist/2-transport/*"
    },
    "#capabilities/*": {
      "types": "./src/3-capabilities/*",
      "default": "./dist/3-capabilities/*"
    },
    "#job-wiring/*": {
      "types": "./src/4-job-wiring/*",
      "default": "./dist/4-job-wiring/*"
    },
    "#platform/*": {
      "types": "./src/0-platform/*",
      "default": "./dist/0-platform/*"
    },
    "#formula": {
      "types": "./src/0-platform/formula/index.ts",
      "default": "./dist/0-platform/formula/index.js"
    },
    "#formula/*": {
      "types": "./src/0-platform/formula/*",
      "default": "./dist/0-platform/formula/*"
    },
    "#name-manager": {
      "types": "./src/3-capabilities/name-manager/index.ts",
      "default": "./dist/3-capabilities/name-manager/index.js"
    },
    "#name-manager/*": {
      "types": "./src/3-capabilities/name-manager/*",
      "default": "./dist/3-capabilities/name-manager/*"
    },
    "#structured-data": {
      "types": "./src/3-capabilities/structured-data/index.ts",
      "default": "./dist/3-capabilities/structured-data/index.js"
    },
    "#structured-data/*": {
      "types": "./src/3-capabilities/structured-data/*",
      "default": "./dist/3-capabilities/structured-data/*"
    },
    "#context": {
      "types": "./src/3-capabilities/context/index.ts",
      "default": "./dist/3-capabilities/context/index.js"
    },
    "#context/*": {
      "types": "./src/3-capabilities/context/*",
      "default": "./dist/3-capabilities/context/*"
    }
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@icarus/shared": "workspace:*",
    "better-sqlite3": "^13.0.2",
    "dotenv": "^16.6.1",
    "fastify": "^5.0.0",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.7.4",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3"
  }
}
