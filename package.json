{
  "name": "icarus",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "dev:backend": "pnpm --filter @icarus/backend dev",
    "dev:frontend": "pnpm --filter @icarus/frontend dev",
    "test": "pnpm -r --if-present test",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "clean": "pnpm -r clean"
  }
}
